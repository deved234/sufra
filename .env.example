# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string for the app user (readWrite on the database only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=sufra

# Database name. Defaults to "sufra". Use a separate one for local work and
# for Vercel Preview deployments (e.g. sufra-dev, sufra-preview).
MONGODB_DB=sufra-dev

# Email over SMTP (Gmail by default). Use a Gmail account with 2-Step Verification
# and an app password: https://myaccount.google.com/apppasswords
# Leave both empty locally and emails are printed to the server console instead.
SMTP_USER=
SMTP_PASS=
# Optional, for another provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# "Continue with Google" (OAuth client of type Web application, created at
# https://console.cloud.google.com/auth/clients). Register these redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your production domain>/api/auth/google/callback
# Leave empty and the Google button is hidden. It's always hidden on Vercel
# Preview deployments, whose addresses can't be registered ahead of time.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
